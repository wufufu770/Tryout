# Tryout 非 Docker 版环境变量示例
# 复制为 .env 并按需修改(.env 已在 .gitignore 中,不会提交)
# 或直接在启动脚本中设置系统环境变量

# ==== 基础配置 ====

# 监听端口(默认 3001)
PORT=3001

# 监听地址(默认 127.0.0.1,仅本机访问)
# 局域网访问设为 0.0.0.0(注意配合防火墙和认证使用)
HOST=127.0.0.1

# 数据目录(默认 ./data)
# Windows 下若路径含非 ASCII 字符(如用户名),必须改为纯英文路径,否则 sqlite3 无法打开
DB_DIR=./data

# 运行环境(production / development)
# production:禁用认证豁免、隐藏错误堆栈、启用 HSTS
NODE_ENV=development

# ==== 认证 ====

# 访问 token(多个用逗号分隔)
# 不设置则首次启动自动生成到 data/.api_token
# 注:变量名保留 INTERVIEWX_ 前缀,与旧版配置兼容
# INTERVIEWX_API_TOKEN=your-token-here

# 禁用认证(仅开发,production 环境禁止设为 1)
# INTERVIEWX_AUTH_DISABLED=1

# API Key 加密主密钥(用于加密供应商 API Key)
# 不设置则自动生成到 data/.master_key
# 生产环境务必通过环境变量注入,不要依赖自动生成的文件
# INTERVIEWX_MASTER_KEY=your-master-key-here

# ==== 网络与代理 ====

# 反向代理模式(后端在 Nginx 等反代后时设为 1)
# BEHIND_PROXY=1 时,Express 信任一层 X-Forwarded-For,req.ip 取真实客户端 IP
# 不设置时,req.ip 为 TCP 连接地址(最安全,防 XFF 伪造绕过限流)
# BEHIND_PROXY=1

# CORS 白名单(逗号分隔,默认允许本地开发端口)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420,http://localhost:5180

# ==== LLM 配置 ====

# Ollama 本地模型地址(非 Docker 版默认指向本机)
OLLAMA_URL=http://localhost:11434/v1

# LLM 请求超时(毫秒,默认 60s)
# LLM_TIMEOUT_MS=60000

# 流式首 token 超时(毫秒,默认 30s,超时则中断防止上游 hang)
# LLM_FIRST_TOKEN_TIMEOUT_MS=30000

# 日 token 预算(默认 50 万,超出拒绝新请求)
DAILY_TOKEN_BUDGET=500000

# ==== 日志 ====

# 日志级别(trace/debug/info/warn/error,默认 info)
# LOG_LEVEL=info
