# Tryout Docker 部署环境变量示例
# 复制为 .env 并按需修改(Docker Compose 会自动读取同目录下的 .env 文件)
# 或直接在 docker-compose.yml 的 environment 段配置

# API 访问令牌(不设置则首次启动自动生成到 /data/.api_token)
# API_TOKEN=

# 主加密密钥(不设置则自动生成到 /data/.master_key)
# MASTER_KEY=

# 反向代理模式(compose 内 nginx 已配置反代,保持 1 让限流基于真实客户端 IP)
BEHIND_PROXY=1

# CORS 白名单(Docker 版前端端口为 9090)
CORS_ORIGINS=http://localhost:9090,http://127.0.0.1:9090

# Ollama 本地模型地址(容器内通过 host.docker.internal 访问宿主机)
OLLAMA_URL=http://host.docker.internal:11434/v1
